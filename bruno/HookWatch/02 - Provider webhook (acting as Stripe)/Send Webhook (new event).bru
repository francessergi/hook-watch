meta {
  name: Send Webhook (new event)
  type: http
  seq: 1
}

post {
  url: {{base_url}}/hooks/{{public_token}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Webhook-Id: {{$randomUUID}}
  X-Webhook-Event-Type: invoice.paid
}

body:json {
  {
    "event": "invoice.paid",
    "customer": "acme",
    "amount": 1500,
    "currency": "EUR"
  }
}

script:post-response {
  if (res.status === 202) {
    bru.setEnvVar("event_id", res.body.event_id);
  }
}

docs {
  Simulates a third-party provider (e.g. Stripe) delivering a webhook to
  the public URL generated by "Create Endpoint".

  `X-Webhook-Id` uses Bruno's built-in {{$randomUUID}} helper so every run
  sends a fresh, non-duplicate event. Reuse the same value across requests
  if you want to test deduplication instead (see "Send Duplicate Webhook").

  Requires `public_token` to be set (run "01 - Setup / Create Endpoint" first).
}
