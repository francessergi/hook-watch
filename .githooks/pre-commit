#!/bin/sh
# Blocks commits made with the work identity (sergio.frances@metro-markets.de).
# This repo is personal and must never be attributed to the work account.

BLOCKED_EMAIL="sergio.frances@metro-markets.de"
AUTHOR_EMAIL="$(git config user.email)"

if [ "$AUTHOR_EMAIL" = "$BLOCKED_EMAIL" ]; then
  echo "❌ Commit blocked: git user.email is set to '$BLOCKED_EMAIL'."
  echo "   This repo must only be committed to as your personal identity."
  echo "   Fix with:"
  echo "     git config user.name \"Sergi Francés Roca\""
  echo "     git config user.email \"francessergi@hotmail.com\""
  exit 1
fi
